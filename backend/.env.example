# =============================================================================
# ERP Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and update the values.

# Django
DEBUG=True
SECRET_KEY=unsafe-development-key-change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL via Supabase or local)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_CONN_MAX_AGE=0

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Timezone
TIME_ZONE=Asia/Jakarta

# IAM Enforcement (set True after role-permission seeds are installed)
ERP_ENFORCE_IAM=False
ERP_ENFORCE_FIELD_PERMISSIONS=False

# Security (production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
