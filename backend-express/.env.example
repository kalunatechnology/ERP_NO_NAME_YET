# Server
PORT=8001
NODE_ENV=development

# Database
# Local/default fallback. Deployment-specific runtime selection is handled by
# src/config/env.ts according to DEPLOYMENT_TARGET.
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_db"
DIRECT_URL="postgresql://postgres:password@localhost:5432/erp_db"

# Hostinger
# A persistent Hostinger Express process uses SUPABASE_DIRECT_URL (preferred)
# or DIRECT_URL for BOTH runtime queries and Prisma migrations. Use Supabase
# direct PostgreSQL or the IPv4-compatible session pooler on port 5432.
# DATABASE_URL may still contain a provider/legacy pooler value; it is not used
# as the Hostinger runtime connection when DEPLOYMENT_TARGET=hostinger.
# Never use transaction-pooler port 6543 for Hostinger migrations.
DEPLOYMENT_TARGET=local
SUPABASE_DIRECT_URL="postgresql://postgres:<SUPABASE_DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# Vercel only: Supabase transaction pooler, port 6543.
SUPABASE_POOLER_URL="postgresql://postgres.<PROJECT_REF>:<SUPABASE_DB_PASSWORD>@aws-<REGION>.pooler.supabase.com:6543/postgres"

# JWT
# Access-token lifetime is enforced in src/utils/jwt.ts at exactly 24 hours.
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,https://markha.arsalynk.com,http://markha.arsalynk.com,https://marka.arsalynk.com,http://marka.arsalynk.com,https://arsalynk.com,http://arsalynk.com"
CORS_ALLOW_CREDENTIALS=true

# App
TIME_ZONE="Asia/Jakarta"

# Feature Flags
ERP_ENFORCE_IAM=false
ERP_ENFORCE_FIELD_PERMISSIONS=false

# Pagination
PAGE_SIZE=25
MAX_PAGE_SIZE=500
# ERP-owned Marbot integration. Map ERP core_tenant.id to chatbot tenant settings.
# Use distinct high-entropy secrets per tenant; the signing secrets must match
# the chatbot's INBOUND_CONTEXT and OUTBOUND_TOOL tenant keys respectively.
# MARBOT_TENANT_CONFIG_JSON={"<erp-tenant-uuid>":{"externalTenantId":"<core_tenant.code>","chatbotUrl":"https://chatbot-arsalynk.vercel.app","chatbotApiKey":"<tenant-api-key>","inboundContextSecret":"<secret>","outboundToolSecret":"<different-secret>","roleMap":{"DIRECTOR":"EXECUTIVE"}}}
CHATBOT_SERVICE_URL=""
CHATBOT_CONTROL_PLANE_SECRET=""
CHATBOT_CONTRACT_MODE="v2"
ERP_BASE_URL="http://localhost:8001"
# Dedicated PostgreSQL credential: CONNECT + USAGE + SELECT on ai_* views only.
CHATBOT_ERP_READONLY_DATABASE_URL=""
# 32-byte key encoded as 64 hex characters or base64. Never reuse a JWT/HMAC secret.
MARBOT_ENCRYPTION_KEY=""
