{
  "name": "erp-backend-express",
  "version": "1.0.0",
  "description": "ERP Backend — Express.js + TypeScript + Prisma (100% Parity with Django REST Framework)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "node scripts/build.js",
    "build:compile": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "seed": "ts-node prisma/seed.ts",
    "seed:master": "ts-node prisma/seed.master.ts",
    "seed:production": "ts-node prisma/seed.production.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "deploy:hostinger:db": "node scripts/deploy_hostinger_migrations.js",
    "deploy:hostinger": "npm run build",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test:q6": "ts-node --files tests/q6.integration.ts",
    "test:q7": "ts-node --files tests/q7.integration.ts",
    "test:q9": "ts-node --files tests/q9-access.integration.ts",
    "test:q9:http": "ts-node --files tests/q9-http.integration.ts",
    "test:q9:delegation": "ts-node --files tests/q9-user-module-delegation.integration.ts",
    "test:q10:bdd": "ts-node --files tests/q10-system.bdd.ts",
    "test:q10:access": "ts-node --files tests/q10-company-admin-access.bdd.ts",
    "test:q11": "ts-node --files tests/q11-system-guardrails.ts",
    "test:pagination": "ts-node --files tests/pagination.unit.ts",
    "test:marbot-signature": "ts-node --files tests/marbot-signature.unit.ts",
    "test:marbot-tenant": "ts-node --files tests/marbot-tenant.unit.ts",
    "test:marbot-runtime-v2": "ts-node --files tests/marbot-runtime-context-v2.unit.ts",
    "test:marbot-tool-hmac-v2": "ts-node --files tests/marbot-tool-hmac-v2.unit.ts",
    "test:marbot-control-plane-v2": "ts-node --files tests/marbot-control-plane-v2.unit.ts",
    "test:marbot-project-scope": "ts-node --files tests/marbot-project-scope.integration.ts",
    "test:marbot-secrets": "ts-node --files tests/marbot-secret.unit.ts",
    "test:jwt-expiry": "ts-node --files tests/jwt-expiry.unit.ts",
    "test:marbot-deployment": "ts-node --files tests/marbot-deployment.smoke.ts",
    "test:reporting-scope": "ts-node --files tests/reporting-global-scope.unit.ts",
    "test:project-authority": "ts-node --files tests/project-acting-manager.unit.ts",
    "test:project-financials": "ts-node --files tests/project-financial-targets.unit.ts",
    "test:project-input-validation": "ts-node --files tests/project-input-validation.unit.ts",
    "benchmark:q10:login": "node scripts/benchmark_demo_login.js",
    "reconcile:q9": "ts-node scripts/reconcile_q9_access.ts",
    "reconcile:q10": "ts-node scripts/reconcile_q10_test_baseline.ts",
    "audit:db-architecture": "node scripts/audit_database_architecture.js",
    "audit:project-progress": "ts-node scripts/audit_project_progress.ts",
    "reconcile:project-progress": "ts-node scripts/reconcile_project_progress.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "uuid": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.15.5",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "tar": "^7.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
